package layouts

import (
	"strings"
	"instalbloc/internal/domain"
	"instalbloc/internal/views/components"
)

type PageMeta struct {
	Title        string
	Description  string
	CanonicalURL string
	NoIndex      bool
	CSPNonce     string
	CurrentYear  int
	Session      domain.SessionView
}

func (m PageMeta) ResolvedTitle() string {
	if strings.TrimSpace(m.Title) == "" {
		return "InstalBloc | Reparații Sanitare, Termice și Intervenții Blocuri România"
	}
	return m.Title + " | InstalBloc"
}

func (m PageMeta) ResolvedDescription() string {
	if strings.TrimSpace(m.Description) == "" {
		return "Platforma națională dedicată asociațiilor de proprietari, administratorilor de bloc și locatarilor din România. Conectăm rapid blocurile cu instalatori autorizați, firme de hidroizolații, centrale termice, interfoane și intervenții de urgență."
	}
	return m.Description
}

func (m PageMeta) KeywordsCSV() string {
	return domain.CanonicalSEOKeywords
}

func (m PageMeta) RobotsDirective() string {
	if m.NoIndex {
		return "noindex, nofollow"
	}
	return "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
}

templ Base(meta PageMeta) {
	<!DOCTYPE html>
	<html lang="ro">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#ea580c"/>
			<title>{ meta.ResolvedTitle() }</title>
			<meta name="description" content={ meta.ResolvedDescription() }/>
			<meta name="keywords" content={ meta.KeywordsCSV() }/>
			<meta name="robots" content={ meta.RobotsDirective() }/>
			if meta.CanonicalURL != "" {
				<link rel="canonical" href={ meta.CanonicalURL }/>
			}
			<meta property="og:title" content={ meta.ResolvedTitle() }/>
			<meta property="og:description" content={ meta.ResolvedDescription() }/>
			<meta property="og:locale" content="ro_RO"/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content="InstalBloc"/>
			<link rel="manifest" href="/manifest.json"/>
			<link rel="icon" href="/icon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/>
			<link rel="stylesheet" href="/css/styles.css"/>
			<script src="/js/htmx.min.js" nonce={ meta.CSPNonce } defer></script>
			<script src="/js/alpine.min.js" nonce={ meta.CSPNonce } defer></script>
			<script src="/js/pwa-init.js" nonce={ meta.CSPNonce } defer></script>
		</head>
		<body class="font-sans antialiased bg-stone-50 text-slate-900 min-h-screen flex flex-col">
			@components.Navbar(meta.Session)
			<main id="main-content" class="flex-1 flex flex-col w-full">
				{ children... }
			</main>
			@components.Footer(meta.CurrentYear)
		</body>
	</html>
}
