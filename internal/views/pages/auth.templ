package pages

import "instalbloc/internal/views/layouts"

templ LoginPage(meta layouts.PageMeta, errMsg string, infoMsg string, emailVal string) {
	@layouts.Base(meta) {
		<section class="py-12 px-4 max-w-md mx-auto w-full">
			<div class="bg-white rounded-2xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-6">
				<div class="text-center space-y-2">
					<h1 class="text-2xl font-bold text-slate-900">Intră în Contul InstalBloc</h1>
					<p class="text-sm text-slate-600">
						Acces pentru Asociații de Proprietari, Locatari și Firme / Instalatori.
					</p>
				</div>

				if errMsg != "" {
					<div class="p-3.5 rounded-xl bg-red-50 border border-red-300 text-red-700 text-sm font-medium" role="alert">
						{ errMsg }
					</div>
				}

				if infoMsg != "" {
					<div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium" role="status">
						{ infoMsg }
					</div>
				}

				<form action="/login" method="POST" class="space-y-4">
					<div class="space-y-1">
						<label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Adresă de Email</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							autocomplete="email"
							value={ emailVal }
							placeholder="nume@exemplu.ro"
							class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-white text-sm text-slate-900"
						/>
					</div>

					<div class="space-y-1">
						<div class="flex items-center justify-between">
							<label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Parolă</label>
							<a href="/forgot-password" class="text-xs font-semibold text-orange-600 hover:underline">Ai uitat parola?</a>
						</div>
						<input
							id="password"
							name="password"
							type="password"
							required
							autocomplete="current-password"
							placeholder="••••••••"
							class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-white text-sm text-slate-900"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-3 px-4 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm shadow-xs transition-colors"
					>
						Autentificare în Platformă
					</button>
				</form>

				<div class="pt-4 border-t border-stone-200 text-center text-xs text-slate-600">
					Nu ai încă un cont pe platformă?
					<a href="/onboarding" class="font-bold text-orange-600 hover:underline">Creează cont nou &rarr;</a>
				</div>
			</div>
		</section>
	}
}

templ VerifyOTPPage(meta layouts.PageMeta, email string, purpose string, errMsg string) {
	@layouts.Base(meta) {
		<section class="py-12 px-4 max-w-md mx-auto w-full">
			<div class="bg-white rounded-2xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-6">
				<div class="text-center space-y-2">
					<h1 class="text-2xl font-bold text-slate-900">Verificare Cod de Securitate (2FA)</h1>
					<p class="text-sm text-slate-600">
						Am trimis un cod din 6 cifre pe adresa <span class="font-semibold text-slate-900">{ email }</span>.
					</p>
				</div>

				if errMsg != "" {
					<div class="p-3.5 rounded-xl bg-red-50 border border-red-300 text-red-700 text-sm font-medium" role="alert">
						{ errMsg }
					</div>
				}

				<form action="/verify-otp" method="POST" class="space-y-4">
					<input type="hidden" name="email" value={ email }/>
					<input type="hidden" name="purpose" value={ purpose }/>

					<div class="space-y-1">
						<label for="code" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Cod din 6 cifre</label>
						<input
							id="code"
							name="code"
							type="text"
							inputmode="numeric"
							pattern="[0-9]{6}"
							maxlength="6"
							required
							placeholder="123456"
							class="w-full px-4 py-3 rounded-xl border border-stone-300 bg-white text-center font-mono text-xl font-bold tracking-wider text-slate-900"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-3 px-4 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm shadow-xs transition-colors"
					>
						Confirmă Codul
					</button>
				</form>
			</div>
		</section>
	}
}

templ ForgotPasswordPage(meta layouts.PageMeta, errMsg string, infoMsg string) {
	@layouts.Base(meta) {
		<section class="py-12 px-4 max-w-md mx-auto w-full">
			<div class="bg-white rounded-2xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-6">
				<div class="text-center space-y-2">
					<h1 class="text-2xl font-bold text-slate-900">Recuperare Parolă</h1>
					<p class="text-sm text-slate-600">
						Introdu adresa de email asociată contului tău pentru a primi codul de resetare.
					</p>
				</div>

				if errMsg != "" {
					<div class="p-3.5 rounded-xl bg-red-50 border border-red-300 text-red-700 text-sm font-medium" role="alert">
						{ errMsg }
					</div>
				}

				if infoMsg != "" {
					<div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium" role="status">
						{ infoMsg }
					</div>
				}

				<form action="/forgot-password" method="POST" class="space-y-4">
					<div class="space-y-1">
						<label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Adresă de Email</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							placeholder="nume@exemplu.ro"
							class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-white text-sm text-slate-900"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-3 px-4 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm shadow-xs transition-colors"
					>
						Trimite Cod de Resetare
					</button>
				</form>

				<div class="pt-4 border-t border-stone-200 text-center text-xs text-slate-600">
					<a href="/login" class="font-bold text-orange-600 hover:underline">&larr; Înapoi la Autentificare</a>
				</div>
			</div>
		</section>
	}
}

templ ResetPasswordPage(meta layouts.PageMeta, email string, errMsg string) {
	@layouts.Base(meta) {
		<section class="py-12 px-4 max-w-md mx-auto w-full">
			<div class="bg-white rounded-2xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-6">
				<div class="text-center space-y-2">
					<h1 class="text-2xl font-bold text-slate-900">Setează Parola Nouă</h1>
					<p class="text-sm text-slate-600">
						Introdu codul primit pe <span class="font-semibold text-slate-900">{ email }</span> și noua parolă.
					</p>
				</div>

				if errMsg != "" {
					<div class="p-3.5 rounded-xl bg-red-50 border border-red-300 text-red-700 text-sm font-medium" role="alert">
						{ errMsg }
					</div>
				}

				<form action="/reset-password" method="POST" class="space-y-4">
					<input type="hidden" name="email" value={ email }/>

					<div class="space-y-1">
						<label for="code" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Cod din 6 cifre</label>
						<input
							id="code"
							name="code"
							type="text"
							inputmode="numeric"
							pattern="[0-9]{6}"
							maxlength="6"
							required
							placeholder="123456"
							class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-white font-mono text-base font-bold text-slate-900"
						/>
					</div>

					<div class="space-y-1">
						<label for="new_password" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Parolă Nouă (minim 8 caractere)</label>
						<input
							id="new_password"
							name="new_password"
							type="password"
							minlength="8"
							required
							placeholder="••••••••"
							class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-white text-sm text-slate-900"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-3 px-4 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm shadow-xs transition-colors"
					>
						Actualizează Parola
					</button>
				</form>
			</div>
		</section>
	}
}
