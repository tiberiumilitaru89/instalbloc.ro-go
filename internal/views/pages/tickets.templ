package pages

import (
	"fmt"
	"strconv"

	"instalbloc/internal/domain"
	"instalbloc/internal/views/layouts"
)

type SubscriptionSummaryView struct {
	ID                 int64
	PlanLabel          string
	Status             string
	IsSubscribed       bool
	StartedAtFormatted string
	ExpiresAtFormatted string
	AutoRenew          bool
}

type AssociationOptionView struct {
	ID      int64
	Name    string
	Address string
	County  string
	City    string
}

type TicketCardView struct {
	ID                 int64
	Title              string
	Description        string
	Category           string
	Status             string
