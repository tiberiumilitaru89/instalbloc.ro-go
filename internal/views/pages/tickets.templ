	Urgency            string
	UrgencyLabel       string
	County             string
	Zone               string
	Asociatie          string
	Apartament         string
	TipSpatiu          string
	TipInterventie     string
	ConfirmationsCount int64
	OffersCount        int
	IsRead             bool
	IsReadByAdmin      bool
	IsEscalated2h      bool
	CreatedAtFormatted string
}

