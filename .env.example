# Server configuration
PORT=8080
ENVIRONMENT=development # development | production

# Turso Database
TURSO_DATABASE_URL=libsql://instalbloc-db-your-account.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Session secret (min 32 chars)
SESSION_SECRET=your_random_32_byte_secret_key_here

# Cloudflare R2 Storage (for attachments / files)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=instalbloc-files
R2_PUBLIC_DOMAIN=https://files.instalbloc.ro

# Resend / Email
RESEND_API_API_KEY=re_123456789
EMAIL_FROM=suport@instalbloc.ro

# Netopia Payments (optional for test)
NETOPIA_SIGNATURE=your_netopia_signature
NETOPIA_SANDBOX=true
